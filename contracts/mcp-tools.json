        "$defs": {
          "ItemInput": {
            "additionalProperties": false,
            "properties": {
              "produto_id": {
                "format": "uuid",
                "title": "Produto Id",
                "type": "string"
              },
              "quantidade": {
                "exclusiveMinimum": 0,
                "maximum": 100000,
                "title": "Quantidade",
                "type": "integer"
              },
              "unidade": {
                "const": "UN",
                "default": "UN",
                "title": "Unidade",
                "type": "string"
              }
            },
            "required": [
