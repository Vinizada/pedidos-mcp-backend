                "default": null,
                "title": "Pedido Id"
              },
              "perguntas": {
                "items": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 50,
                "title": "Perguntas",
                "type": "array"
