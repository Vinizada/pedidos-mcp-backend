              },
              "nome": {
                "title": "Nome",
                "type": "string"
              },
              "marca": {
                "title": "Marca",
                "type": "string"
              },
              "categoria": {
                "title": "Categoria",
                "type": "string"
              },
              "unidade": {
                "title": "Unidade",
                "type": "string"
              },
              "embalagem": {
                "title": "Embalagem",
                "type": "string"
              },
              "ativo": {
                "title": "Ativo",
                "type": "boolean"
              },
              "preco_unitario": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
