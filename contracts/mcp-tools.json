              "extracao": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Extracao"
              },
              "modelo": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Modelo",
                "type": "string"
