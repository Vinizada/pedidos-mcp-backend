{
  "name": "Pedidos MCP — ambiente do grupo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Pedidos MCP e API",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "python3 scripts/configurar_env.py",
  "postStartCommand": "python3 scripts/configurar_codespaces.py && docker compose up --build -d",
  "remoteUser": "vscode"
}
