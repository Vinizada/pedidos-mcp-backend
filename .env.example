# Copie com: python3 scripts/configurar_env.py (gera segredos locais aleatórios)
POSTGRES_DB=pedidos
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=substitua-por-uma-senha-local
API_TOKEN=substitua-por-um-token-aleatorio-com-32-caracteres-ou-mais
APP_PORT=8000
SEARCH_MODE=hybrid
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Arrays JSON. Para acesso remoto, inclua o domínio HTTPS da aplicação.
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
